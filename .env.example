# D1: Backend Infrastructure
DATABASE_URL=postgresql://user:password@localhost:5432/storytrace
POSTGRES_PASSWORD=postgres
WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
# Comma-separated origins if frontend and API are on different hosts (e.g. Vercel + VPS)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# D2: Data Sources
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
NEWSAPI_KEY=your_newsapi_key_here

# D3: AI Models
FEATHERLESS_API_KEY=your_featherless_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# D4: Frontend
# Local dev: http://localhost:8000
# Render + Vultr backend: set API_URL on Render (runtime, no rebuild)
# API_URL=http://YOUR_VULTR_IP:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
SPEECHMATICS_KEY=your_speechmatics_api_key_here  # NO NEXT_PUBLIC_ — stays server-side only
